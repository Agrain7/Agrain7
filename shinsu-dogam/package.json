{
  "name": "shinsu-dogam",
  "private": true,
  "version": "1.0.0",
  "description": "신수도감 (神獸圖鑑) — DIVINE BEASTS ATLAS: 한국 전통 영물을 타고 탐험하는 2D 횡스크롤 라이딩 웹게임",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "build:artifact": "node tools/build-artifact.mjs",
    "release": "node tools/release.mjs",
    "release:live": "node tools/release.mjs --live",
    "test:e2e:pay": "node tests/e2e/payment-live.mjs"
  },
  "dependencies": {
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
